# Copy to a protected local file outside Git-managed release directories.
# Never commit the populated file.
HLS_URL=
# RTSP transport for direct credential-bearing Camera 1 reads (transcode and
# analytics). udp (default) | tcp | automatic. The water camera rejects TCP
# SETUP (461 Unsupported Transport) since ~2026-08-23; private relay reads
# always use tcp regardless of this variable.
CAMERA1_RTSP_TRANSPORT=udp
# Legacy base64 auth retained for compatibility with existing HLS/config fetches.
HLS_BASIC_AUTH_BASE64=
# Preferred explicit base64 auth for HTTP(S) media input. Legacy HLS auth
# remains a fallback for HTTP(S) only and is never attached to RTSP input.
HLS_MEDIA_BASIC_AUTH_BASE64=
# Preferred explicit ROI base64 auth. Falls back to legacy HLS auth for
# existing installations until their protected local configuration is migrated.
SEA_SPEED_ROI_BASIC_AUTH_BASE64=
SEA_SPEED_API_URL=
SEA_SPEED_EVENT_API_URL=
SEA_SPEED_API_TOKEN=
ANALYTICS_PROFILE=water-v1
CAMERA_ID=cam1
MODEL_NAME=models/yolo26x.pt
YOLO_TRACKER=bytetrack.yaml
YOLO_IMAGE_SIZE=960
YOLO_CONFIDENCE=0.15
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
SAMPLE_FPS=5
# Issue #700 frame conformance is opt-in (0=off). When enabled, a frame that
# is near-black, a recognized synthetic vertical-bar slate, or pixel-frozen for
# the configured duration is reported as camera state only: analytics and new
# publications are skipped and the worker stays online. All thresholds are
# bounded and read once at worker start. Pixel-only detection cannot guarantee
# zero night-time false positives.
FRAME_CONFORMANCE_ENABLED=0
FRAME_CONFORMANCE_BLACK_LUMA_MAX=16
FRAME_CONFORMANCE_BLACK_STD_MAX=4
FRAME_CONFORMANCE_BLACK_BRIGHT_MAX=28
FRAME_CONFORMANCE_SLATE_BAR_STD_MAX=10
FRAME_CONFORMANCE_SLATE_TRANSITION_MIN=24
FRAME_CONFORMANCE_SLATE_TRANSITIONS_MIN=2
FRAME_CONFORMANCE_SLATE_SAT_MIN=120
FRAME_CONFORMANCE_FREEZE_SEC=10
FRAME_CONFORMANCE_FREEZE_MIN_FRAMES=8
FRAME_CONFORMANCE_FREEZE_DIFF_MAX=2
FRAME_CONFORMANCE_FREEZE_MIN_LUMA=24
# Issue #701 crossing N-of-M voting + transit drift filter (opt-in; off by
# default). Voting is off when CROSSING_VOTE_N=1, CROSSING_VOTE_M=1 and
# CROSSING_DRIFT_PX=0; the legacy single-frame decision then runs unchanged.
# When enabled, a side transition is confirmed only after N observations on the
# destination side within the last M observations (1 <= N <= M); a zero
# (deadzone) observation consumes a window slot without voting, and the Nth
# vote confirms immediately. Direction is computed from the last trusted
# source-side centroid. CROSSING_DRIFT_PX is the minimum NET DISPLACEMENT
# PERPENDICULAR TO THE CONFIGURED LINE, in full-frame pixels, between that
# source-side centroid and the confirmation centroid (0 disables the filter);
# a finite drift >= 1e12 is treated as invalid. Any invalid setting (including
# a non-numeric or non-integral value, N < 1, M < 1, N > M, negative or
# non-finite drift) disables ALL THREE values together and falls back to the
# legacy off state (N=M=1, drift 0); the worker keeps running with the old
# decision code.
CROSSING_VOTE_N=1
CROSSING_VOTE_M=1
CROSSING_DRIFT_PX=0
# Issue #699 — opt-in recorder of ORIGINAL ENCODED media to dacha.
# Issue #699b — recorder source selector: hls (default) | rtsp.
# Default OFF (SEA_SPEED_RECORDER_ENABLED accepts only 0 or 1).
# hls reads SEA_SPEED_RECORDER_HLS_URL, which must be an explicit authorized
# HTTP(S) HLS playlist URL; there is no RTSP fallback and no ffmpeg remux.
# rtsp reads the existing HLS_URL above, which must be an absolute rtsp:// URL
# with a host, and stream-copies the original encoded video into 2-second
# segmented Matroska via ffmpeg (no decode, no re-encode). Credential-free
# relay reads use tcp; a credential-bearing direct Camera 1 URL follows
# CAMERA1_RTSP_TRANSPORT. Both arms use the same bounded rsync delivery and
# introduce no new URL, key or tuning knobs.
# The SSH key is root-owned at /etc/sea-speed/recorder_ed25519 and exposed by
# LoadCredential as /run/credentials/recorder_ed25519 (never from /home).
# Destination MUST stay relative (Issue #739): the restricted rrsync -wo
# endpoint already pins /mnt/fleet-backup/sea-speed, and an absolute path is
# doubled by rrsync (mkdir "/mnt/fleet-backup/sea-speed/mnt/..." fails).
# Local spool stays under the service WorkingDirectory; 64 MiB per object and a
# 12 GiB free-space floor bound local usage (the RTSP arm holds at most two
# 64 MiB slots per camera).
SEA_SPEED_RECORDER_ENABLED=0
SEA_SPEED_RECORDER_SOURCE_TYPE=hls
SEA_SPEED_RECORDER_HLS_URL=
SEA_SPEED_RECORDER_SPOOL_DIR=recorder-spool
SEA_SPEED_RECORDER_DESTINATION=root@10.123.239.127:./
SEA_SPEED_RECORDER_POLL_SEC=2
SEA_SPEED_RECORDER_OBJECT_MAX_BYTES=67108864
SEA_SPEED_RECORDER_MIN_FREE_BYTES=12884901888
SEA_SPEED_RECORDER_HTTP_TIMEOUT_SEC=30
SEA_SPEED_RECORDER_RSYNC_TIMEOUT_SEC=60
SEA_SPEED_RECORDER_RSYNC_RETRIES=3
SEA_SPEED_RECORDER_RSYNC_BACKOFF_SEC=5
