# Copy to a protected local file outside Git-managed release directories.
# Never commit the populated file.
HLS_URL=
# RTSP transport for direct credential-bearing Camera 1 reads (transcode and
# analytics). udp (default) | tcp | automatic. The water camera rejects TCP
# SETUP (461 Unsupported Transport) since ~2026-08-23; private relay reads
# always use tcp regardless of this variable.
CAMERA1_RTSP_TRANSPORT=udp
# Legacy base64 auth retained for compatibility with existing HLS/config fetches.
HLS_BASIC_AUTH_BASE64=
# Preferred explicit base64 auth for HTTP(S) media input. Legacy HLS auth
# remains a fallback for HTTP(S) only and is never attached to RTSP input.
HLS_MEDIA_BASIC_AUTH_BASE64=
# Preferred explicit ROI base64 auth. Falls back to legacy HLS auth for
# existing installations until their protected local configuration is migrated.
SEA_SPEED_ROI_BASIC_AUTH_BASE64=
SEA_SPEED_API_URL=
SEA_SPEED_EVENT_API_URL=
SEA_SPEED_API_TOKEN=
ANALYTICS_PROFILE=water-v1
CAMERA_ID=cam1
MODEL_NAME=models/yolo26x.pt
YOLO_TRACKER=bytetrack.yaml
YOLO_IMAGE_SIZE=960
YOLO_CONFIDENCE=0.15
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
SAMPLE_FPS=5