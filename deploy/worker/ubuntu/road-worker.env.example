# Generated/populated only in protected runtime configuration.
# `HLS_URL` must resolve to the private on-demand preview relay for logical road1;
# do not place camera credentials or the physical camera address in Git.
# `SEA_SPEED_API_URL` and `SEA_SPEED_EVENT_API_URL` are derived by
# configure-analytics-profiles.py from the protected Camera 1 private Worker->VPS M2M endpoint.
# Do not point Road Worker at the public Authentik protected /sea-speed/** browser/API surface.
ANALYTICS_PROFILE=road-v1
CAMERA_ID=road1
HLS_URL=
SEA_SPEED_API_URL=
SEA_SPEED_EVENT_API_URL=
SEA_SPEED_API_TOKEN=
MODEL_NAME=models/yolo26x.pt
YOLO_TRACKER=bytetrack.yaml
YOLO_IMAGE_SIZE=960
YOLO_CONFIDENCE=0.15
FRAME_WIDTH=1920
FRAME_HEIGHT=1080
SAMPLE_FPS=10
YOLO_HALF=1
YOLO_CLASSES_FILTER=0
MOTION_GATE_MODE=gated
LATEST_FRAME_BOUNDED=1
