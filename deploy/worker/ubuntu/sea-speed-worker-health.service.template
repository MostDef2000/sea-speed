[Unit]
Description=Sea Speed worker exact-release health check
Documentation=https://github.com/MostDef2000/sea-speed
After=sea-speed-worker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=__INSTALL_ROOT__/releases/__SOURCE_COMMIT__/venv/bin/python __INSTALL_ROOT__/releases/__SOURCE_COMMIT__/source/deploy/worker/ubuntu/check-worker-health.py --install-root __INSTALL_ROOT__ --service-name sea-speed-worker.service --expected-commit __SOURCE_COMMIT__ --heartbeat __INSTALL_ROOT__/shared/runtime/worker-heartbeat.json --write-report __INSTALL_ROOT__/observability/worker-health-report.json --max-heartbeat-age-sec 30 --max-frame-age-sec 30 --max-state-post-age-sec 90 --min-free-gib 10 --require-gpu
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sea-speed-worker-health
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=__INSTALL_ROOT__/observability

[Install]
WantedBy=multi-user.target
