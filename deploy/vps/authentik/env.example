# Copy to .env on the VPS and populate there. Never commit the populated file.
PG_DB=authentik
PG_USER=authentik
PG_PASS=
AUTHENTIK_SECRET_KEY=
AUTHENTIK_HTTP_PORT=9000

# One-time bootstrap. Remove AUTHENTIK_BOOTSTRAP_PASSWORD from the runtime
# environment after the first Owner account has been verified.
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# SMTP used for invitations/recovery. Values remain runtime secrets.
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__USE_SSL=false
AUTHENTIK_EMAIL__TIMEOUT=10
AUTHENTIK_EMAIL__FROM=

AUTHENTIK_ERROR_REPORTING__ENABLED=false
