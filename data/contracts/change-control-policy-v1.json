{
  "schema": "sea-speed-change-control-policy/v1",
  "version": "1.2.0",
  "impact_classes": [
    "NONE",
    "CONTROL_PLANE",
    "VPS",
    "UBUNTU_WORKER",
    "MIXED"
  ],
  "rules": [
    {
      "impact": "VPS",
      "patterns": [
        "api/**",
        "frontend/**",
        "deploy/vps/**"
      ]
    },
    {
      "impact": "UBUNTU_WORKER",
      "patterns": [
        "deploy/worker/ubuntu/**",
        "worker/ubuntu_*"
      ]
    },
    {
      "impact": "CONTROL_PLANE",
      "patterns": [
        "worker/*.ps1",
        "worker/*.cmd",
        "worker/windows/**",
        "worker/README.txt",
        "worker/UPDATE.md"
      ]
    },
    {
      "impact": "UBUNTU_WORKER",
      "patterns": [
        "worker/**"
      ]
    },
    {
      "impact": "CONTROL_PLANE",
      "patterns": [
        ".github/workflows/**",
        "deploy/**",
        "schemas/**",
        "scripts/ci/**",
        "scripts/operations/**",
        "scripts/quality/**",
        "scripts/release/**",
        "contracts/**",
        "data/contracts/**",
        "data/quality/**"
      ]
    }
  ],
  "required_sections": [
    "Canonical task",
    "Change",
    "Impact",
    "Delivery",
    "Validation",
    "Completion"
  ]
}
