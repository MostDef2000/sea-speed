{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostdef.ru/sea-speed/schemas/telemetry.schema.json",
  "title": "Sea Speed runtime telemetry",
  "oneOf": [
    {"$ref": "#/$defs/workerState"},
    {"$ref": "#/$defs/vehicleEvent"}
  ],
  "$defs": {
    "commitIdentity": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$|^unknown$"
    },
    "workerState": {
      "type": "object",
      "required": [
        "state_schema",
        "telemetry_schema",
        "worker_source_commit",
        "camera_id",
        "frame_no",
        "worker_online",
        "updated_at"
      ],
      "properties": {
        "state_schema": {"const": "sea_speed_worker_state_v1"},
        "telemetry_schema": {"const": "sea_speed_telemetry_v1"},
        "worker_source_commit": {"$ref": "#/$defs/commitIdentity"},
        "camera_id": {"type": "string", "minLength": 1},
        "frame_no": {"type": "integer", "minimum": 0},
        "worker_online": {"type": "boolean"},
        "updated_at": {"type": ["string", "null"]},
        "last_overlay_url": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "vehicleEvent": {
      "type": "object",
      "required": [
        "event_schema",
        "telemetry_schema",
        "worker_source_commit",
        "calibration_version",
        "event_id",
        "created_at",
        "camera_id",
        "class_name",
        "confidence"
      ],
      "properties": {
        "event_schema": {"const": "sea_speed_vehicle_event_v1"},
        "telemetry_schema": {"const": "sea_speed_telemetry_v1"},
        "worker_source_commit": {"$ref": "#/$defs/commitIdentity"},
        "calibration_version": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{16}$"},
        "event_id": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "camera_id": {"type": "string", "minLength": 1},
        "class_name": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "speed_kmh": {"type": ["number", "null"], "minimum": 0},
        "speed_source": {"type": ["string", "null"]},
        "snapshot_url": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  }
}
