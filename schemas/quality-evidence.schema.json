{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mostdef.ru/sea-speed/schemas/quality-evidence.schema.json",
  "title": "Sea Speed quality evidence v1",
  "type": "object",
  "required": ["schema", "source_commit", "quality_context", "state", "artifacts", "contracts", "deployment", "rollback"],
  "properties": {
    "schema": {"const": "sea_speed_quality_evidence_v1"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "quality_context": {"const": "Quality integration gate / quality-integration"},
    "state": {"type": "string", "enum": ["built", "ready_for_deployment"]},
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["component", "filename", "sha256", "size", "files"],
        "properties": {
          "component": {"type": "string", "enum": ["edge", "vps"]},
          "filename": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 1},
          "files": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "contracts": {
      "type": "object",
      "required": ["contract_set", "active_media_mode", "target_media_mode"],
      "properties": {
        "contract_set": {"const": "sea-speed-contracts-v1"},
        "active_media_mode": {"const": "mvp_v1"},
        "target_media_mode": {"const": "edge_v2"}
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["automatic_from_main", "approval", "exact_commit_required"],
      "properties": {
        "automatic_from_main": {"const": false},
        "approval": {"const": "production environment"},
        "exact_commit_required": {"const": true}
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": ["required", "instructions"],
      "properties": {
        "required": {"const": true},
        "instructions": {"type": "string", "minLength": 20}
      },
      "additionalProperties": false
    },
    "sbom": {
      "type": "object",
      "required": ["format", "dependency_files"],
      "properties": {
        "format": {"const": "source-dependency-inventory-v1"},
        "dependency_files": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
